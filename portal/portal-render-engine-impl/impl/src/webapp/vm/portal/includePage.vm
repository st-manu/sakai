#if ($pageColumnLayout == 'col1')
    #set($columnClasses = "Mrphs-pageColumns Mrphs-pageColumns--single")
#elseif ($pageColumnLayout == 'col1of2')
    #set($columnClasses = "sakai-page-column sakai-page-column--half")
#end

#set($i = 0) ## Counter for directUrl ids

#set($homePage = false)
#foreach( $page in $sitePages.pageNavTools )
    #if (${page.current} && ${page.pageProps.is_home_page})
        #set($homePage = true)
        #break
    #end
#end

<!-- START VM includePage.vm -->

#if ( $pageColumn1Tools )
    #set( $numberTools = $pageColumn0Tools.size() + $pageColumn1Tools.size() )
#else
    #set( $numberTools = $pageColumn0Tools.size() )
#end

<div class="portal-main-container sakai-portal-main sakai-main-column">
    #parse("/vm/portal/snippets/main-toolbar-snippet.vm")

    <main id="$pageWrapperClass" class="portal-main-content sakai-page-content #if( $numberTools > 1 || $homePage)Mrphs-multipleTools #end" role="main" tabindex="-1">
        <h1 class="skip visually-hidden" tabindex="-1" id="tocontent">${rloader.sit_contentshead}</h1>

        #parse("/vm/portal/snippets/siteStatus-snippet.vm")
        #if ($pageTwoColumn)
        <div class="row">
        #end
        <div id="$pageColumnLayout" class="${columnClasses}">

            #foreach ( $tool in $pageColumn0Tools )

                #set( $i = $i + 1 )

                #if ($tool)

                    <!-- start Tool Container -->

                    #set($toolTitleClass = ${tool.toolId.trim().replace(".", '-').toLowerCase()})

                    <div class="Mrphs-container Mrphs-${toolTitleClass}">

                    <!-- start Tool Header: portal omits tool title on single-tool pages (breadcrumb owns site › tool + reset). Multi-tool / home keeps portlet titles. -->
                    #set($showPortalToolTitle = false)
                    #if (!$tool.suppressTitle && ($numberTools > 1 || $homePage))
                        #set($showPortalToolTitle = true)
                    #end

                    #if ($showPortalToolTitle || ${tool.toolJSR168Edit})

                        #if (${tool.hasRenderResult})
                            <nav class="sakai-page-header Mrphs-toolTitleNav Mrphs-container--toolTitleNav #if(!$showPortalToolTitle)sakai-page-header--actions-only#end" aria-label="${rloader.sit_toolnavigation}">
                                #if ($showPortalToolTitle)
                                    #if (${tool.toolShowResetButton})
                                        #if ($!{tool.toolInline})
                                            <h2 class="sakai-page-header__title Mrphs-toolTitleNav__title">
                                                <a href="${tool.toolResetActionUrl}" title="${rloader.sit_reset}: ${tool.toolRenderResult.getTitle()}">
                                                    <span class="Mrphs-toolTitleNav__link Mrphs-toolTitleNav__link--reset"></span>
                                                    <span class="sakai-page-header__title-text Mrphs-toolTitleNav__text">${tool.toolRenderResult.getTitle()}</span>
                                                </a>
                                            </h2>
                                        #else
                                            <h2 class="sakai-page-header__title Mrphs-toolTitleNav__title">
                                                <a class="Mrphs-toolTitleNav__link--inline" href="${tool.toolResetActionUrl}" target="${tool.toolPlacementIDJS}" title="${rloader.sit_reset}: ${tool.toolRenderResult.getTitle()}">
                                                    <span class="Mrphs-toolTitleNav__link Mrphs-toolTitleNav__link--reset"></span>
                                                    <span class="sakai-page-header__title-text Mrphs-toolTitleNav__text">${tool.toolRenderResult.getTitle()}</span>
                                                </a>
                                            </h2>
                                        #end
                                    #else
                                        <h2 class="sakai-page-header__title Mrphs-toolTitleNav__title"><span class="sakai-page-header__title-text Mrphs-toolTitleNav__text">${tool.toolRenderResult.getTitle()}</span><span class="Mrphs-toolTitleNav__addLeft"></span></h2>
                                    #end
                                #end

                                <div class="Mrphs-toolTitleNav__button_container #if(${homePage})home#end">
                                #if (${tool.toolJSR168Edit})
                                    <a class="tool-button-container si si-edit __link--edit" accesskey="e" id="jsr-edit" href="${tool.toolJSR168Edit}" title="${rloader.sit_edit}">
                                        <span class="Mrphs-itemTitle">${rloader.sit_edit}</span>
                                    </a>
                                #end
                                </div>
                            </nav>
                        #elseif ($showPortalToolTitle)
                            <nav class="sakai-page-header Mrphs-toolTitleNav Mrphs-container Mrphs-container--toolTitleNav" aria-label="${rloader.sit_toolnavigation}">
                                #if (${tool.toolShowResetButton})
                                    <h2 class="sakai-page-header__title Mrphs-toolTitleNav__title">
                                        <a href="${tool.toolResetActionUrl}" target="${tool.toolPlacementIDJS}" title="${sitReset}: ${tool.toolTitle}">
                                            <span class="tool-button-container si si-close __link--reset">
                                                <span class="Mrphs-itemTitle">${sitReset}</span>
                                            </span>
                                            ${tool.toolTitle}
                                        </a>
                                    </h2>
                                #else
                                    <h2 class="sakai-page-header__title Mrphs-toolTitleNav__title">${tool.toolTitle}</h2>
                                #end
                            </nav>
                        #end

                    #end
                    <!-- END Tool Header -->

                    <!-- START Tool Body -->

                    #if ( ${bufferedResponse} && ${responseBody} )

                        <!-- Buffered Body Tool Content -->
                        ${responseBody}
                        <!-- End Buffered Body Tool Content -->

                    #else

                        #parse("/vm/portal/snippets/toolBody-snippet.vm")

                    #end ## END of IF ( ${bufferedResponse} && ${responseBody} )

                    <!-- end Tool Body -->

                    </div>

                    <!-- end Tool Container -->

                #end ## END of IF ($tool)

            #end ## END of FOREACH ( $tool in $pageColumn0Tools )

        </div>

        #if ($pageTwoColumn)

            <div id="col2of2" class="sakai-page-column sakai-page-column--half">

                #foreach ( $tool in $pageColumn1Tools )

                    #set( $i = $i + 1)

                    #if ($tool)

                        <!-- start Tool Container -->

                        #set($toolTitleClass = ${tool.toolId.trim().replace(".", '-').toLowerCase()})

                        <div class="Mrphs-container Mrphs-${toolTitleClass}">

                        <!-- start include tool -->
                        <!-- start Tool Col2 -->

                        #set($showPortalToolTitle = false)
                        #if (!$tool.suppressTitle && ($numberTools > 1 || $homePage))
                            #set($showPortalToolTitle = true)
                        #end

                        #if ($showPortalToolTitle || ${tool.toolJSR168Edit})
                            #if (${tool.hasRenderResult})
                                <nav class="sakai-page-header Mrphs-toolTitleNav Mrphs-container Mrphs-container--toolTitleNav #if(!$showPortalToolTitle)sakai-page-header--actions-only#end" aria-label="${rloader.sit_toolnavigation}">
                                    #if ($showPortalToolTitle)
                                        #if (${tool.toolShowResetButton})
                                            <h2 class="sakai-page-header__title Mrphs-toolTitleNav__title">
                                                <a href="${tool.toolResetActionUrl}" target="${tool.toolPlacementIDJS}" title="${rloader.sit_reset}: ${tool.toolRenderResult.getTitle()}">
                                                    <span class="Mrphs-toolTitleNav__link Mrphs-toolTitleNav__link--reset"></span>
                                                    ${tool.toolRenderResult.getTitle()}
                                                </a>
                                            </h2>
                                        #else
                                            <h2 class="sakai-page-header__title Mrphs-toolTitleNav__title">${tool.toolRenderResult.getTitle()}</h2>
                                        #end
                                    #end
                                    <div class="Mrphs-toolTitleNav__button_container">
                                    #if (${tool.toolJSR168Edit})
                                        <a class="tool-button-container si si-edit __link--edit" accesskey="e" id="jsr-edit" href="${tool.toolJSR168Edit}" title="${rloader.sit_edit}">
                                            <span class="Mrphs-itemTitle">${rloader.sit_edit}</span>
                                        </a>
                                    #end
                                    </div>
                                </nav>
                            #elseif ($showPortalToolTitle)
                                <nav class="sakai-page-header Mrphs-toolTitleNav Mrphs-container Mrphs-container--toolTitleNav" aria-label="${rloader.sit_toolnavigation}">
                                    #if (${tool.toolShowResetButton})
                                        <h2 class="sakai-page-header__title Mrphs-toolTitleNav__title">
                                            <a href="${tool.toolResetActionUrl}" target="${tool.toolPlacementIDJS}" title="${sitReset}: ${tool.toolTitle}">
                                                <span class="Mrphs-toolTitleNav__link Mrphs-toolTitleNav__link--reset"></span>
                                                ${tool.toolTitle}
                                            </a>
                                        </h2>
                                    #else
                                        <h2 class="sakai-page-header__title Mrphs-toolTitleNav__title">${tool.toolTitle}</h2>
                                    #end
                                </nav>
                            #end
                        #end
	                  <!-- end Tool Col2 -->
	                  <!-- start Tool Body -->

	                  #parse("/vm/portal/snippets/toolBody-snippet.vm")

	                  <!-- end Tool Body -->

	                  <!-- end include tool -->

	                  </div>

	                  <!-- end Tool Container -->


                    #end ## END of IF ($tool)

                #end ## END of FOREACH ( $tool in $pageColumn1Tools )

            </div> <!-- end of #col2of2 -->
        </div> <!-- end of row -->

        #end ## END of IF ($pageTwoColumn)

        #if ( $toolDirectUrlEnabled)

            #set($allTools = [])
            #if($pageColumn0Tools)
                #set($dummy = $allTools.addAll($pageColumn0Tools))
            #end
            #if($pageColumn1Tools)
                #set($dummy = $allTools.addAll($pageColumn1Tools))
            #end

            #set($j = 0)

            <aside class="offcanvas offcanvas-end sakai-offcanvas sakai-no-print" tabindex="-1" id="sakai-directlink-panel" aria-labelledby="sakai-directlink-label">

                <div class="offcanvas-header sakai-offcanvas__header">
                    <h2 class="offcanvas-title sakai-offcanvas__title" id="sakai-directlink-label">
                        ${rloader.tool_direct_button_link}
                    </h2>
                    <button type="button" class="btn-close sakai-offcanvas__close" data-bs-dismiss="offcanvas" aria-label="${rloader.sit_closepage}"></button>
                </div>

                <div class="offcanvas-body sakai-offcanvas__body">
                    #if ( !$allTools.isEmpty() )
                        <ul class="sakai-direct-link__list">
                            #foreach ( $tool in $allTools )
                                #if ( $tool.directToolUrl && ${tool.showDirectToolUrl} )

                                    #set($j = $j + 1)

                                    <li class="sakai-direct-link__item">
                                        <h3 class="sakai-direct-link__title">${tool.toolTitle}</h3>
                                        #if($toolShortUrlEnabled)
                                            <label class="sakai-direct-link__short" for="directToolUrl-${j}">
                                                <input type="checkbox" id="directToolUrl-${j}"
                                                    data-direct-link-toggle
                                                    data-direct-url="${tool.directToolUrl}"
                                                    data-target="${tool.toolPlacementIDJS}_urlholder">
                                                <span>${rloader.short_url}</span>
                                            </label>
                                        #end
                                        <textarea readonly id="${tool.toolPlacementIDJS}_urlholder" class="sakai-form-control sakai-direct-link__textarea">${tool.directToolUrl}</textarea>
                                    </li>
                                #end
                            #end
                        </ul>
                    #else
                        <p class="sakai-direct-link__empty">${rloader.tool_direct_link_not_available}</p>
                    #end
                </div>
            </aside>
        #end
    </main>

    ## Footer ##

    #define ($showFooter)
        #parse("/vm/portal/includeFooter.vm")
    #end

    #set($showFooter = true)
    #if ($showFooter)
        #parse("/vm/portal/includeFooter.vm")
    #end

</div>
<!-- END VM includePage.vm -->
