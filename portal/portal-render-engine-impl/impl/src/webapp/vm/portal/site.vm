##<!-- START VM site.vm --> ## Comments seen before doctype. Internet Explorer will go into the quirks mode.
## Create a variable that is a dollar sign for later
#set ( $d = "$")

#parse("/vm/portal/includeStandardHead.vm")

    #if (!${loggedIn})
        #set ($loggedInClass = "is-logged-out")
    #end

    #if (${sidebarCollapsed})
        #set ($sidebarCollapsedClass = "sidebar-collapsed")
        #set ($sidebarCollapseBtnTitle = $rloader.mainnav_btn_sidebar_expand)
    #else
        #set ($sidebarCollapseBtnTitle = $rloader.mainnav_btn_sidebar_collapse)
    #end
    #set ($portalNavSidebarIcon = "bi-list")


    <noscript>
        <span id="portal_js_warn" class="Mrphs-noJs js-warn-no-js">${rloader.sit_noscript_message}</span>
    </noscript>
    
    #if ( ${bufferedResponse} && ${responseHead} )
    #else 
        ${sakai_html_head_js}
    #end ## END of IF ( ${bufferedResponse} && ${responseHead} )

    <body class="sakai-portal-body Mrphs-portalBody overflow-hidden $!{loggedInClass}" data-bs-no-jquery="true">

        #parse("/vm/portal/snippets/noscript-snippet.vm")

        #if (${roleSwitchState}) 
            #set ($roleSwitchClass = "swapped-view")
        #end

        <div id="pageBody"
             class="sakai-portal-wrapper Mrphs-portalWrapper vh-100 portal-container $!{roleSwitchClass} $!{sidebarCollapsedClass}" tabindex="0">
            <div class="portal-pasystem"></div>
            ## Skip Nav (a11y links)
            #parse("/vm/portal/snippets/skipNav-snippet.vm")

            ## Mobile-only slim top bar (desktop chrome lives in sidebar + main toolbar)
            #parse("/vm/portal/snippets/header-snippet.vm")

            #parse("/vm/portal/moresites.vm")

            ## Sites sidebar (full-height on desktop)
            #parse("/vm/portal/includeSiteNav.vm")

            ## Main column: toolbar + page card + footer
            #parse("/vm/portal/includePage.vm")

            ## Notification sidebar
            #parse("/vm/portal/snippets/notifications-snippet.vm")

            #parse("/vm/portal/snippets/calendar-snippet.vm")

            ## Search sidebar
            #parse("/vm/portal/snippets/search-snippet.vm")

            ## Qicklinks sidebar
            #parse("/vm/portal/snippets/quicklinks-snippet.vm")

            ## Profile sidebar
            #parse("/vm/portal/snippets/profile-snippet.vm")

            ## Mobile footer
            #parse("/vm/portal/includeMobileFooter.vm")
        </div> <!-- end sakai-portal-wrapper Mrphs-portalWrapper -->

        <!-- END VM site.vm -->
        ## Make sure we at least have a jQuery 1.12 or higher, log messages
    #set ( $d = "$")
        #parse("/vm/portal/includeAnalytics.vm")

        #parse("/vm/portal/includeBodyScripts.vm")

        #parse("/vm/portal/includePASystem.vm")

        #parse("/vm/portal/includeCookieNotice.vm")

        #parse("/vm/portal/includeGoogleTM-NoScript.vm")

        ${includeExtraHead}

    </body>
</html>
