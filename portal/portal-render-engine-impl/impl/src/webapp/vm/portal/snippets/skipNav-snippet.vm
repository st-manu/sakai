<nav id="skipNav" class="sakai-skip-nav sakai-no-print" aria-label="${rloader.sit_skipnavigation}">
    <ul class="sakai-skip-nav__menu">

        #if ($siteNavHasAccessibilityURL)
            <li class="sakai-skip-nav__menuitem sakai-skip-nav__menuitem--accessibility">
                <a href="$siteNavAccessibilityURL" class="sakai-skip-nav__link" title="${rloader.sit_accessibility}" accesskey="0">
                    ${rloader.sit_accessibility}
                    <span class="accesibility_key">[0]</span>
                </a>
            </li>
        #end ## END of IF ($siteNavHasAccessibilityURL)
        <li class="sakai-skip-nav__menuitem sakai-skip-nav__menuitem--content">
            <a href="#tocontent" class="sakai-skip-nav__link" title="${rloader.sit_jumpcontent}" accesskey="c">
                ${rloader.sit_jumpcontent}
                <span class="accesibility_key">[c]</span>
            </a>
        </li>
        #if (${userIsLoggedIn})
        <li class="sakai-skip-nav__menuitem sakai-skip-nav__menuitem--worksite">
            <button type="button"
                    class="sakai-skip-nav__link"
                    data-bs-toggle="modal"
                    data-bs-target="#select-site-sidebar"
                    aria-controls="select-site-sidebar"
                    title="${rloader.sit_jumpworksite}"
                    accesskey="w">
                <i class="si si-all-sites all-sites-icon" aria-hidden="true"></i> ${rloader.sit_worksites}
                <span class="accesibility_key">[w]</span>
            </button>
        </li>
        #end ## END of IF ($userIsLoggedIn)
        <li class="sakai-skip-nav__menuitem sakai-skip-nav__menuitem--tools">
            <a id="totool" href="#totoolmenu" class="sakai-skip-nav__link" title="${rloader.sit_jumptools}" accesskey="l">
                <i class="si si-sakai-sites" aria-hidden="true"></i>
                ${rloader.sit_menutools}
                <span class="accesibility_key">[l]</span>
            </a>
			#foreach( $page in $sitePages.pageNavTools )
				#if (${page.current})
					<a href="${page.pageResetUrl}" title="$rloader.sit_reset" class="sakai-skip-nav__link">
						<span class="Mrphs-breadcrumb--icon ${page.menuClass} $!{page.menuClassOverride}"></span>
						<span>${page.pageTitle}</span>
					</a>

                    #if(${sitePages.canManageOverview} && ${page.pageProps.is_home_page})
                        <a href="${sitePages.manageOverviewUrl}" title="$rloader.sit_manover" class="sakai-skip-nav__link">
                            <span class="si si-edit"></span>$rloader.sit_manover
                        </a>
                    #end
                    #if(${sitePages.canManageOverviewHome} && ${page.pageProps.is_home_page})
                        <a href="${sitePages.manageOverviewUrlInHome}" title="$rloader.sit_manover" class="sakai-skip-nav__link">
                            <span class="si si-edit"></span>$rloader.sit_manover
                        </a>
                    #end
				#end
			#end
        </li>
    </ul>
</nav>
<script>
    window.addEventListener("load", function() {
        document.getElementById("totool").addEventListener("click", function() {
            const firstTool = document.querySelector("#current-site-pages .sakai-sidebar-page__link");
            firstTool?.focus();
        });
    });
</script>
