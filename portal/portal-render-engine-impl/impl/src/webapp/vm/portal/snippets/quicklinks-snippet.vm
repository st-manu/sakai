#if (${quickLinks} && ${userIsLoggedIn})
<aside class="offcanvas offcanvas-end sakai-offcanvas sakai-no-print" tabindex="-1" id="sakai-quickLinksPanel" aria-labelledby="sakai-quickLinksPanelLabel">
  <div class="offcanvas-header sakai-offcanvas__header">
    <h2 class="offcanvas-title sakai-offcanvas__title" id="sakai-quickLinksPanelLabel">${rloader.sit_quick_links}</h2>
    <button type="button" class="btn-close sakai-offcanvas__close" data-bs-dismiss="offcanvas" aria-label="${rloader.sit_closepage}"></button>
  </div>
  <div class="offcanvas-body sakai-offcanvas__body">
    <p class="sakai-offcanvas__intro">${quickLinksInfo}</p>
    <ul class="sakai-offcanvas-nav">
    #foreach($quickLink in $quickLinks)
      <li>
        <a class="sakai-offcanvas-nav__link" href="${quickLink.url}" title="$quickLink.title" target="_blank" rel="noreferrer">
          #if(${quickLink.iconType} == "image")
            <span class="sakai-quick-link__icon" style="--sakai-quick-link-icon: url(${quickLink.imageURI})" aria-hidden="true"></span>
          #elseif (${quickLink.iconType} == "icon")
            <span class="sakai-quick-link__icon ${quickLink.iconClass}" aria-hidden="true"></span>
          #end
          <span>${quickLink.name}</span>
        </a>
      </li>
    #end
    </ul>
  </div>
</aside>
#end
