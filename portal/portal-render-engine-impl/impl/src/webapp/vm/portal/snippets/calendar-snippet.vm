<aside class="offcanvas offcanvas-end sakai-offcanvas" tabindex="-1" id="sakai-calendar-panel" aria-labelledby="sakai-calendar-panel-label">
  <div class="offcanvas-header sakai-offcanvas__header">
    <h2 class="offcanvas-title sakai-offcanvas__title" id="sakai-calendar-panel-label">${rloader.calendar_title}</h2>
    <button type="button" class="btn-close sakai-offcanvas__close" data-bs-dismiss="offcanvas" aria-label="${rloader.calendar_close_label}"></button>
  </div>
  <div class="offcanvas-body sakai-offcanvas__body">
    <sakai-calendar defer></sakai-calendar>
  </div>
</aside>
