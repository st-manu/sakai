<form id="loginForm" method="post" action="${loginPortalPath}/xlogin" enctype="application/x-www-form-urlencoded" class="text-light me-3">
	<label for="eid">${loginEidWording}</label>
	<input name="eid" id="eid" type="text" placeholder="${eidPlaceholder}" autocomplete="username">
	<label for="pw">${loginPwWording}</label>
	<input name="pw" id="pw" type="password" placeholder="${pwPlaceholder}" autocomplete="current-password">
	<input name="submit" id="submit" type="submit" value="${loginWording}">
</form>
