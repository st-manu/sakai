#if (${userIsLoggedIn})
<div class="portal-header-breadcrumb">
    <div class="portal-header-breadcrumb-item portal-header-all-sites">
        <button type="button"
            class="portal-header-breadcrumb__all-sites"
            data-bs-toggle="modal"
            data-bs-target="#select-site-sidebar"
            aria-controls="select-site-sidebar"
            title="${rloader.sit_allsites}"
            aria-label="${rloader.sit_allsites}">
            <span class="bi bi-grid-3x3-gap-fill" aria-hidden="true"></span>
            <span>${rloader.sit_more}</span>
        </button>
    </div>
    <div class="bi bi-chevron-right portal-header-breadcrumb-separator" aria-hidden="true"></div>

    #if ($!siteParents)
        #foreach ($parent in $siteParents)
        <div class="portal-header-breadcrumb-item portal-header-site-title">
            <a href="$!{parent.siteUrl}" title="$!{parent.siteTitle}">
                $parent.siteTitle
            </a>
        </div>
        <div class="bi bi-chevron-right portal-header-breadcrumb-separator" aria-hidden="true"></div>
        #end
    #end

    <div id="header-site-title" class="portal-header-breadcrumb-item portal-header-site-title portal-header-site-title--current">
        <a href="$!{siteUrl}" title="$!{siteTitle}">
            $siteTitle#if (${currentRole} && !$roleSwitchState) <span class="portal-header-site-role">(${rloader.sit_role} ${currentRole})</span>#end
        </a>
    </div>

    #foreach( $page in $sitePages.pageNavTools )
        #if ($page.current)
        <div class="bi bi-chevron-right portal-header-breadcrumb-separator" aria-hidden="true"></div>
        <div class="portal-header-breadcrumb-item header-tool-title">
            <a href="${page.pageResetUrl}" title="${page.pageTitle}">
                ${page.pageTitle}
            </a>
        </div>

        #if(${sitePages.canManageOverview} && ${page.pageProps.is_home_page})
            <a href="${sitePages.manageOverviewUrl}" title="$rloader.sit_manover" class="Mrphs-hierarchy-item manage-overview-link sakai-breadcrumb-manage">
                <span class="bi bi-pencil" aria-hidden="true"></span>$rloader.sit_manover
            </a>
        #end
        #if(${sitePages.canManageOverviewHome} && ${page.pageProps.is_home_page})
            <a href="${sitePages.manageOverviewUrlInHome}" title="$rloader.sit_manover" class="Mrphs-hierarchy-item manage-overview-link sakai-breadcrumb-manage">
                <span class="bi bi-pencil" aria-hidden="true"></span>$rloader.sit_manover
            </a>
        #end

        #end
    #end
</div>
#end
