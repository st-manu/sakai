<!DOCTYPE html>
<html lang="$!{locale}" dir="$!{dir}" class="sakai-html Mrphs-html">
    <head>
        <meta charset="utf-8">
        <title>${loginRequired} - ${uiService}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link href="${pageSkinRepo}/${pageSkin}/tool.css" type="text/css" rel="stylesheet" media="all" />
        <script src="/library/js/headscripts.js$!{portalCDNQuery}"></script>
    </head>
    <body class="sakai-portal-body sakai-login-page">
        <main class="sakai-login-page__main">
            <section class="sakai-login-page__visual" aria-hidden="true">
                <img class="sakai-login-page__logo" src="/library/skin/${pageSkin}/images/sakaiLogo.png" alt="">
            </section>

            <section class="sakai-login-page__panel">
                <div class="sakai-login-page__form-shell">
                    <header class="sakai-login-page__header">
                        <h1 class="sakai-login-page__title">${loginWording}</h1>
                        <button type="button" class="d-none btn-close sakai-login-page__close" data-bs-dismiss="modal" aria-label="${rloader.login_close}"></button>
                    </header>

                    #if ($notify)
                        #set ($hasErrorsClass = "is-invalid")
                        <div class="sak-banner-error" role="alert">${notify}</div>
                    #end

                    #set ($showInternalLogin = !$containerLogin || $xloginInternalEnabled || !$loginContainerUrl)

                    #if ($showInternalLogin)
                        <form action="${action}" method="post" class="sakai-login-page__form">
                            <div class="sakai-form-group">
                                <label for="eid" class="sakai-form-label">${rloader.login_username}</label>
                                <input id="eid" name="eid" value="${eid}" type="text" class="form-control sakai-form-control $!{hasErrorsClass}" autocomplete="username">
                            </div>

                            <div class="sakai-form-group">
                                <label for="pw" class="sakai-form-label">${rloader.login_password}</label>
                                <div class="input-group password-field">
                                    <input id="pw" name="pw" value="${password}" type="password" class="form-control sakai-form-control $!{hasErrorsClass}" autocomplete="current-password">
                                    <input type="checkbox" class="btn-check" id="showPw" autocomplete="off">
                                    <label class="input-group-text" for="showPw">
                                        <span class="bi bi-eye-slash-fill" aria-hidden="true"></span>
                                        <span class="visually-hidden">${rloader.login_show_pw}</span>
                                    </label>
                                </div>
                            </div>

                            <div class="sakai-login-page__actions">
                                <button type="submit" id="submit" class="sakai-btn sakai-btn-primary sakai-login-page__submit">${loginWording}</button>
                                #if (${doCancel})
                                    <input name="cancel" type="submit" class="sakai-btn sakai-btn-secondary" value="${cancelWording}">
                                #end
                            </div>
                        </form>

                        #if (${passwordResetUrl})
                            <a href="${passwordResetUrl}" class="sakai-login-page__link">${passwordResetWording}</a>
                        #end
                    #end

                    #if (${loginContainerUrl})
                        <div class="sakai-login-page__external #if ($showInternalLogin) sakai-login-page__external--with-form #end">
                            #if (${xloginChoice})
                                <p class="sakai-login-page__hint">${xloginChoice}</p>
                            #end
                            <a href="${loginContainerUrl}" class="sakai-btn #if ($showInternalLogin) sakai-btn-secondary #else sakai-btn-primary #end sakai-login-page__external-link">${containerText}</a>
                        </div>
                    #end
                </div>
            </section>
        </main>

        <script src="/library/js/portal/portal.login.password.js$!{portalCDNQuery}"></script>
        <script>
            // Setup show/hide and capslock functionality
            const passwordField = document.querySelector(".password-field");
            if (passwordField) {
                new PasswordField(passwordField, {
                    icons: {
                        hidden: "bi-eye-slash-fill",
                        shown: "bi-eye-fill",
                        capsLock: "bi-capslock-fill"
                    }
                });
            }

            // Focus the username field on load
            window.addEventListener("load", () => document.querySelector("#eid")?.focus());

            // Remove the error class from the form fields when the user starts typing
            const formFields = document.querySelectorAll(".sakai-form-control");
            const removeInvalid = () => formFields.forEach(el => el.classList.remove("is-invalid"));
            formFields.forEach(input => {
                input.addEventListener("input", removeInvalid, { once: true });
                input.addEventListener("click", removeInvalid, { once: true });
            });
        </script>
    </body>
</html>
