#parse("/vm/announcement/announcements_macros.vm")

<div class="portletBody sakai-tool-body sakai-announcements">
	#announcementsHeader($tlang.getString("pre.preview") "" "" "doCancel")
	#announcementsAlert($alertMessage)

	<dl class="sakai-announcements__details">
		<div class="sakai-announcements__detail">
			<dt>$tlang.getString("gen.subject")</dt>
			<dd>$formattedText.escapeHtml($subject)</dd>
		</div>
		<div class="sakai-announcements__detail">
			<dt>$tlang.getString("gen.from")</dt>
			<dd>$formattedText.escapeHtml($user.DisplayName)</dd>
		</div>
		<div class="sakai-announcements__detail">
			<dt>$tlang.getString("displayto.access")</dt>
			<dd>
				#if ($annTo == "pubview")
					$tlang.getString("displayto.public")
				#elseif ($annTo == "site")
					$tlang.getString("displayto.site")
				#elseif ($annTo == "groups")
					$tlang.getString("displayto.selected")
				#elseif ($annTo == "roles")
					$tlang.getString("displayto.roles")
				#end
			</dd>
		</div>
		#if ($annTo == "groups")
			<div class="sakai-announcements__detail">
				<dt>$tlang.getString("groups")</dt>
				<dd>$formattedText.escapeHtml($annToGroups)</dd>
			</div>
		#elseif ($annTo == "roles")
			<div class="sakai-announcements__detail">
				<dt>$tlang.getString("roles")</dt>
				<dd>$formattedText.escapeHtml($annToRoles)</dd>
			</div>
		#end
		<div class="sakai-announcements__detail">
			<dt>$tlang.getString("pre.notif")</dt>
			<dd>$noti</dd>
		</div>
	</dl>

	<section class="sakai-form-section">
		<h2 class="sakai-form-section__title">$tlang.getString("meta.message")</h2>
		<div class="sakai-announcements__body">$formattedText.escapeHtmlFormattedText($body)</div>
	</section>

	#set ($size = 0)
	#if (!$attachments.isEmpty())
		<section class="sakai-form-section">
			<h2 class="sakai-form-section__title">$tlang.getString("meta.attach")</h2>
			<ul class="sakai-announcements__attachments">
				#set ($props = false)
				#set ($size = $attachments.size())
				#foreach ($attachment in $attachments)
					#set ($props = $attachment.Properties)
					#if (!$props)
						#if ($size > 0) #set ($size = $size - 1) #end
					#else
						<li>
							#if ($props.getBooleanProperty($props.NamePropIsCollection))
								<img src="#imageLink($contentTypeImageService.getContentTypeImage("folder"))" alt="" />
							#else
								<img src="#imageLink($contentTypeImageService.getContentTypeImage($props.getProperty($props.NamePropContentType)))" alt="" />
							#end
							<a href="$attachment.Url" target="_blank" title="$tlang.getString("gen.newwindow")">$formattedText.escapeHtml($attachment.Properties.getPropertyFormatted("DAV:displayname"))</a>
							#if (!$props.getBooleanProperty($props.NamePropIsCollection) && $props.getProperty("DAV:getcontenttype") != "text/url")
								<span class="sakai-announcements__attachment-size">($props.getPropertyFormatted($props.NamePropContentLength))</span>
							#end
						</li>
					#end
					#set ($props = false)
				#end
			</ul>
		</section>
	#end

	<form name="form2" method="post" action="#toolForm("AnnouncementAction")">
		<div class="sakai-actions">
			<button type="submit" accesskey="s" class="sakai-btn sakai-btn-primary" name="eventSubmit_doPost">
				#if ($newAnn == "true")
					$tlang.getString("revise.add")
				#else
					$tlang.getString("revise.savechanges")
				#end
			</button>
			<button type="submit" accesskey="e" class="sakai-btn sakai-btn-secondary" name="eventSubmit_doPreviewrevise">$tlang.getString("gen.revise")</button>
			<button type="submit" accesskey="x" class="sakai-btn sakai-btn-ghost" name="eventSubmit_doPreviewrevise">$tlang.getString("gen.cancel")</button>
		</div>
		<input type="hidden" name="sakai_csrf_token" value="$sakai_csrf_token" />
	</form>
</div>
