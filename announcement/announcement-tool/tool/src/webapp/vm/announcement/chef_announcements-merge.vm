#parse("/vm/announcement/announcements_macros.vm")

<div class="portletBody sakai-tool-body sakai-announcements">
	#announcementsHeader($tlang.getString("merge.show") "" "" "doCancel")

	<form name="Options" action="#toolForm("$action")" method="post">
		#announcementsAlert($alertMessage)
		<p class="sakai-announcements__hint">$tlang.getString("merge.select")</p>

		<div class="sakai-table-wrap">
			<table class="sakai-table sakai-table--hover">
				<caption class="visually-hidden">$tlang.getString("merge.list.summary")</caption>
				<thead>
					<tr>
						<th id="announcementSite" scope="col">$tlang.getString("gen.site")</th>
						<th id="checkbox" scope="col" class="sakai-table__select">$tlang.getString("merge.showann")</th>
					</tr>
				</thead>
				<tbody>
					#set ($siteNumber = 1)
					#foreach ($announcementEntry in $mergedAnnouncementsCollection)
						#if ($announcementEntry.isVisible())
							<tr>
								<td headers="announcementSite">
									<label for="site$siteNumber">$formattedText.escapeHtml($announcementEntry.getDisplayName())</label>
								</td>
								<td headers="checkbox" class="sakai-table__select">
									<input type="checkbox" id="site$siteNumber" name="$announcementEntry.getReference()" value="$announcementEntry.getReference()"
										#if ($announcementEntry.isMerged())checked="checked"#end />
								</td>
							</tr>
							#set($siteNumber = $siteNumber + 1)
						#end
					#end
				</tbody>
			</table>
		</div>

		<div class="sakai-actions">
			<input type="submit" class="sakai-btn sakai-btn-primary" accesskey="s" name="eventSubmit_doUpdate" value="$tlang.getString("gen.save")" />
			<input type="submit" class="sakai-btn sakai-btn-ghost" accesskey="x" name="eventSubmit_doCancel" value="$tlang.getString("gen.cancel")" />
		</div>
		<input type="hidden" name="state" value="$state" />
		<input type="hidden" name="sakai_csrf_token" value="$sakai_csrf_token" />
	</form>
</div>
