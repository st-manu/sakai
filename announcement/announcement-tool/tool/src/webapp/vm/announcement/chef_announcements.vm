#parse("/vm/announcement/announcements_macros.vm")

<script src="/library/js/spinner.js$!{portalCdnQuery}"></script>

#macro(announcementsRowClass $props $displayOptions $hidden $reorder)
    #set($isInactive = false)
    #set($now = $timeservice.newTime())
    #if (!$props.isEmpty() && $props.getProperty("releaseDate"))
        #if ($now.before($props.getTimeProperty("releaseDate"))) #set($isInactive = true) #end
    #end
    #if (!$props.isEmpty() && $props.getProperty("retractDate"))
        #if ($now.after($props.getTimeProperty("retractDate"))) #set($isInactive = true) #end
    #end
    #if ($hidden) #set($isInactive = true) #end
    class="sakai-announcements__row#if($displayOptions.isShowAnnouncementBody()) sakai-announcements__row--with-body#end#if($isInactive) sakai-announcements__row--inactive#end#if($reorder) reorder-element#end"
#end

<div class="portletBody sakai-tool-body sakai-announcements">
    #set ($daysList = [$displayOptions.numberOfDaysInThePast])

    #if ($isOnWorkspaceTab.equals("true")) ## My Workspace tab
        #announcementsHeader($tlang.getString("gen.list.title") "doNewannouncement" $menu "")
        #announcementsAlert($alertMessage)

        <div class="sakai-table-toolBar sakai-announcements__toolbar">
            <div class="sakai-table-filterContainer">
                <form name="viewForm" class="sakai-announcements__inline-form" method="post" action="#toolForm("AssignmentAction")">
                    <input type="hidden" name="eventSubmit_doView" value="view" />
                    <label for="view">$tlang.getString("view.label")</label>
                    <select id="view" name="view" class="sakai-form-control sakai-form-control--sm" size="1" onchange="document.viewForm.submit();">
                        <option value="view.all" #if ($!view == "view.all")selected="selected"#end >$!tlang.getString('view.all')</option>
                        <option value="view.public"  #if ($!view == "view.public")selected="selected"#end >$!tlang.getString('view.public')</option>
                        <option value="view.bygroup" #if ($!view == "view.bygroup")selected="selected"#end >$!tlang.getString('view.bygroup')</option>
                        ## no Posted/Scheduled/Drafts options here: the workspace list is built by
                        ## getViewableMessages(), which strips drafts and unreleased messages before
                        ## the view filter runs, so those filters could never return anything
                        <option value="view.byrole" #if ($!view == "view.byrole")selected="selected"#end >$!tlang.getString('view.byrole')</option>
                    </select>
                    <input type="hidden" name="sakai_csrf_token" value="$sakai_csrf_token" />
                </form>
            </div>
            #if ($messageListVector.iterator().hasNext())
                <div class="sakai-announcements__pager">
                    <p class="sakai-announcements__pager-label">$tlang.getFormattedMessage("gen.viewing.phrase", $announcementItemRangeArray)</p>
                    <div class="sakai-announcements__pager-controls">
                        #if ($pagesize != 0)
                            <form name="firstpageForm" class="inlineForm" method="post" action="#toolForm("$action")">
                                <button type="submit" class="sakai-btn sakai-btn-icon" name="eventSubmit_doList_first" value="first" title="$tlang.getString("gen.first")" #if ($goFPButton != "true")disabled="disabled"#end>
                                    <span class="bi bi-chevron-double-left" aria-hidden="true"></span>
                                    <span class="visually-hidden">$tlang.getString("gen.first")</span>
                                </button>
                                <input type="hidden" name="sakai_csrf_token" value="$sakai_csrf_token" />
                            </form>
                            <form name="prevpageForm" class="inlineForm" method="post" action="#toolForm("$action")">
                                <button type="submit" class="sakai-btn sakai-btn-icon" name="eventSubmit_doList_prev" value="prev" title="$tlang.getFormattedMessage('gen.previous.pagesize', $pagesize)" accesskey="p" #if ($goPPButton != "true")disabled="disabled"#end>
                                    <span class="bi bi-chevron-left" aria-hidden="true"></span>
                                    <span class="visually-hidden">$tlang.getFormattedMessage('gen.previous.pagesize', $pagesize)</span>
                                </button>
                                <input type="hidden" name="sakai_csrf_token" value="$sakai_csrf_token" />
                            </form>
                        #end
                        <form name="pagesizeForm" class="sakai-announcements__inline-form" method="post" action="#toolForm("$action")">
                            <input type="hidden" name="eventSubmit_doChange_pagesize" value="changepagesize" />
                            <label for="selectPageSize" class="visually-hidden">$tlang.getString("gen.select.label")</label>
                            <select id="selectPageSize" name="selectPageSize" class="sakai-form-control sakai-form-control--sm" onchange="document.pagesizeForm.submit();">
                                <option value="5" #if($pagesize == 5) selected="selected" #end>$tlang.getFormattedMessage("gen.show", "5")</option>
                                <option value="10" #if($pagesize == 10) selected="selected" #end>$tlang.getFormattedMessage("gen.show", "10")</option>
                                <option value="20" #if($pagesize == 20) selected="selected" #end>$tlang.getFormattedMessage("gen.show", "20")</option>
                                <option value="50" #if($pagesize == 50) selected="selected" #end>$tlang.getFormattedMessage("gen.show", "50")</option>
                                <option value="100" #if($pagesize == 100) selected="selected" #end>$tlang.getFormattedMessage("gen.show", "100")</option>
                                <option value="200" #if($pagesize == 200) selected="selected" #end>$tlang.getFormattedMessage("gen.show", "200")</option>
                            </select>
                            <input type="hidden" name="sakai_csrf_token" value="$sakai_csrf_token" />
                        </form>
                        #if ($pagesize != 0)
                            <form name="nextpageForm" class="inlineForm" method="post" action="#toolForm("$action")">
                                <button type="submit" class="sakai-btn sakai-btn-icon" name="eventSubmit_doList_next" value="next" title="$tlang.getFormattedMessage('gen.next.pagesize', $pagesize)" accesskey="n" #if ($goNPButton != "true")disabled="disabled"#end>
                                    <span class="bi bi-chevron-right" aria-hidden="true"></span>
                                    <span class="visually-hidden">$tlang.getFormattedMessage('gen.next.pagesize', $pagesize)</span>
                                </button>
                                <input type="hidden" name="sakai_csrf_token" value="$sakai_csrf_token" />
                            </form>
                            <form name="lastpageForm" class="inlineForm" method="post" action="#toolForm("$action")">
                                <button type="submit" class="sakai-btn sakai-btn-icon" name="eventSubmit_doList_last" value="last" title="$tlang.getString('gen.last')" #if ($goLPButton != "true")disabled="disabled"#end>
                                    <span class="bi bi-chevron-double-right" aria-hidden="true"></span>
                                    <span class="visually-hidden">$tlang.getString("gen.last")</span>
                                </button>
                                <input type="hidden" name="sakai_csrf_token" value="$sakai_csrf_token" />
                            </form>
                        #end
                    </div>
                </div>
            #end
        </div>

        #if ($messageListVector.iterator().hasNext())
            <form name="announcementListForm" action="#toolForm("AnnouncementAction")" method="post">
                <div class="sakai-table-wrap">
                    <table id="announcements-list" class="sakai-table sakai-table--hover sakai-table--stack">
                        <caption class="visually-hidden">$tlang.getString('gen.tablecaptionworksp')</caption>
                        <thead>
                            <tr>
                                #announcementsSortTh("subject" "subject" "doSortbysubject" $tlang.getString('gen.subject') $tlang.getString('gen.sortby') $tlang.getString('gen.sortbyasc') $tlang.getString('gen.sortbydesc') "sakai-table__primary")
                                #announcementsSortTh("author" "from" "doSortbyfrom" $tlang.getString('gen.from') $tlang.getString('gen.sortbyauth') $tlang.getString('gen.sortbyauthasc') $tlang.getString('gen.sortbyauthdesc') "sakai-table__nowrap")
                                #announcementsSortTh("date" "date" "doSortbydate" $tlang.getString('gen.date') $tlang.getString('gen.sortbydate') $tlang.getString('gen.sortbydateasc') $tlang.getString('gen.sortbydatedesc') "sakai-table__nowrap")
                                <th scope="col" class="sakai-table__actions sakai-no-print">
                                    <span class="visually-hidden">$tlang.getString('gen.actions')</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            #set($rowCount = 0)
                            #foreach ($ann_item in $showMessagesList)
                                #set($rowCount = $rowCount + 1)
                                #set($ann_item_props = $ann_item.getProperties())
                                <tr #announcementsRowClass($ann_item_props $displayOptions $ann_item.Header.draft false)>
                                    <td headers="subject" class="sakai-table__primary" data-label="$tlang.getString('gen.subject')">
                                        #announcementsSubjectMarkers($ann_item)
                                        #if ($ann_item.Header.draft)
                                            <a href="#toolLinkParam("AnnouncementAction" "doReviseannouncement" "itemReference=$formattedText.escapeUrl($ann_item.reference)")" title="$tlang.getString('gen.editdraft')">$tlang.getFormattedMessage("gen.draft.subject", $formattedText.escapeHtml($ann_item.Header.subject))</a>
                                        #else
                                            <a href="#toolLinkParam("AnnouncementAction" "doShowmetadata" "itemReference=$formattedText.escapeUrl($ann_item.reference)")" title="$tlang.getFormattedMessage('gen.viewann.subject', $formattedText.escapeHtml($ann_item.Header.subject))">$formattedText.escapeHtml($ann_item.Header.subject)</a>
                                        #end
                                    </td>
                                    <td headers="author" class="sakai-table__nowrap" data-label="$tlang.getString('gen.from')">
                                        $formattedText.escapeHtml($ann_item.AuthorDisplayName)
                                    </td>
                                    <td headers="date" class="sakai-table__nowrap" data-label="$tlang.getString('gen.date')">
                                        $ann_item.Header.Date.toStringLocalFull()
                                    </td>
                                    <td class="sakai-table__actions sakai-no-print">
                                        #announcementsRowActions($ann_item)
                                    </td>
                                </tr>
                                #if ($displayOptions.isShowAnnouncementBody())
                                    <tr class="sakai-announcements__body-row">
                                        <td colspan="4">
                                            <div class="sakai-announcements__body">$ann_item.TrimmedBody</div>
                                        </td>
                                    </tr>
                                #end
                            #end
                        </tbody>
                    </table>
                </div>
                <input type="hidden" name="sakai_csrf_token" value="$sakai_csrf_token" />
            </form>
        #else
            #announcementsEmptyState($view)
        #end

    #else ## not in a My Workspace tab
        #if ($toolId == "sakai.synoptic.announcement")
            ## Home dashboard widget: rendered inside another tool, no tool header.
            #announcementsAlert($alertMessage)

            <form name="announcementListForm" action="#toolForm("AnnouncementAction")" method="post">
                #if (!$messageListVector.iterator().hasNext())
                    <div class="sakai-banner sakai-banner--info" role="status">$tlang.getString("gen.thereare")</div>
                #else
                    <ul class="synopticList">
                        #foreach ($ann_item in $showMessagesList)
                            #set($isHighlighted = $ann_item.getProperties().getProperty("highlight"))
                            <li>
                                #if (!$ann_item.Header.draft)
                                    <div class="textPanelHeader#if("$!isHighlighted" == "true") font-bold-highlighted#end">
                                        #if ("$!isHighlighted" == "true")
                                            <span class="bi bi-star-fill" aria-hidden="true" title="$tlang.getString('revise.star.title')"></span>
                                        #end
                                        <a href="#toolLinkParam("AnnouncementAction" "doShowmetadata" "itemReference=$formattedText.escapeUrl($ann_item.reference)")" title="$tlang.getFormattedMessage('gen.viewann.subject', $formattedText.escapeHtml($ann_item.Header.subject))">$formattedText.escapeHtml($ann_item.Header.subject)</a>
                                        #if (!$ann_item.Header.Attachments.isEmpty())
                                            <span class="bi bi-paperclip" aria-hidden="true"></span>
                                            <span class="visually-hidden">$tlang.getString('gen.includeattachments')</span>
                                        #end
                                    </div>

                                    #set($ann_item_props = $ann_item.getProperties())
                                    <p class="textPanelFooter">
                                        ($formattedText.escapeHtml($ann_item.Header.From.DisplayName)

                                        #if (!$ann_item_props.isEmpty() && $ann_item_props.getProperty("releaseDate"))
                                            $ann_item_props.getTimeProperty("releaseDate").toStringLocalFull())
                                        #else
                                            $ann_item.Header.Date.toStringLocalFull())
                                        #end
                                    </p>
                                    #if ($displayOptions.isShowAnnouncementBody())
                                        <div class="textPanel">
                                            $ann_item.TrimmedBody
                                        </div>
                                    #end
                                #end
                            </li>
                        #end
                    </ul>
                #end
                <input type="hidden" name="sakai_csrf_token" value="$sakai_csrf_token" />
            </form>

        #else ## the Announcements tool itself (site or admin MOTD)
            ## Show the site column when the list contains announcements from other sites
            #set ($SiteColumnFlag = 0)
            #foreach ($item in $showMessagesList2)
                #set ($ref = $entityManager.newReference($item.Reference))
                #set ($origChannelRef = $service.channelReference($ref.Context, $ref.Container))
                #if (!$origChannelRef.equals($channel.Reference))
                    #set ($SiteColumnFlag = $SiteColumnFlag + 1)
                #end
            #end

            #if ($displayOptions.isShowAllColumns())
                #announcementsHeader($tlang.getString("gen.list.title") "doNewannouncement" $menu "")
                #announcementsAlert($alertMessage)

                <div class="sakai-table-toolbar">
                    <div class="sakai-table-toolbar__filters">
                    #searchFilterPanel("search-announcement", $searchString, "doSearch", "doSearch_clear")
                        #define($viewSelectOptions)
                        <option value="view.all" #if ($!view == "view.all")selected="selected"#end >$!tlang.getString('view.all')</option>
                        <option value="view.public"  #if ($!view == "view.public")selected="selected"#end >$!tlang.getString('view.public')</option>
                        <option value="view.bygroup" #if ($!view == "view.bygroup")selected="selected"#end >$!tlang.getString('view.bygroup')</option>
                        <option value="view.byrole" #if ($!view == "view.byrole")selected="selected"#end >$!tlang.getString('view.byrole')</option>
                        #if ($allow_new)
                        <option value="view.mine" #if ($!view == "view.mine")selected="selected"#end >$!tlang.getString('view.mine')</option>
                        <option value="view.posted" #if ($!view == "view.posted")selected="selected"#end >$!tlang.getString('view.posted')</option>
                        <option value="view.scheduled" #if ($!view == "view.scheduled")selected="selected"#end >$!tlang.getString('view.scheduled')</option>
                        <option value="view.drafts" #if ($!view == "view.drafts")selected="selected"#end >$!tlang.getString('view.drafts')</option>
                        #end
                        #end
                        #viewFilterPanel("viewFilterForm", "view", $viewSelectOptions, "doView")
                        <span class="sakai-table-toolbar__scope">$tlang.getFormattedMessage("gen.list.scope", $daysList.toArray())</span>
                    </div>
                    #if ($messageListVector.iterator().hasNext())
                        #pagerPanel("pager1")
                    #end
                </div>

                #if ($messageListVector.iterator().hasNext())
                    #set($annColspan = 4)
                    #if ($SiteColumnFlag > 0 && $EnableItemCheckBoxes) #set($annColspan = $annColspan + 1) #end
                    #if ($allow_delete) #set($annColspan = $annColspan + 1) #end
                    <form name="announcementListForm" action="#toolForm("AnnouncementAction")" method="post">
                        <div class="sakai-table-wrap">
                            <table id="announcements-list" class="sakai-table sakai-table--hover sakai-table--stack">
                                <caption class="visually-hidden">$tlang.getString('gen.tablecaptionsite')</caption>
                                <thead>
                                    <tr>
                                        #if ($allow_delete)
                                            <th scope="col" class="sakai-table__select sakai-no-print">
                                                <input type="checkbox" id="announcement-select-all" aria-label="$tlang.getString("gen.selectall.page")" />
                                            </th>
                                        #end
                                        #announcementsSortTh("subject" "subject" "doSortbysubject" $tlang.getString('gen.subject') $tlang.getString('gen.sortby') $tlang.getString('gen.sortbyasc') $tlang.getString('gen.sortbydesc') "sakai-table__primary")
                                        #announcementsSortTh("author" "from" "doSortbyfrom" $tlang.getString('gen.from') $tlang.getString('gen.sortbyauth') $tlang.getString('gen.sortbyauthasc') $tlang.getString('gen.sortbyauthdesc') "sakai-table__nowrap")
                                        #announcementsSortTh("date" "date" "doSortbydate" $tlang.getString('gen.date') $tlang.getString('gen.sortbydate') $tlang.getString('gen.sortbydateasc') $tlang.getString('gen.sortbydatedesc') "sakai-table__nowrap")
                                        #if ($EnableItemCheckBoxes)
                                            #if ($SiteColumnFlag > 0)
                                                #announcementsSortTh("channel" "channel" "doSortbychannel" $tlang.getString('gen.site') $tlang.getString('gen.sortchannel') $tlang.getString('gen.sortchanasc') $tlang.getString('gen.sortchandesc') "sakai-table__nowrap")
                                            #end
                                        #end
                                        <th scope="col" class="sakai-table__actions sakai-no-print">
                                            <span class="visually-hidden">$tlang.getString('gen.actions')</span>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    #set($rowCount = 0)
                                    #foreach ($ann_item in $showMessagesList)
                                        #set($rowCount = $rowCount + 1)
                                        #set($ann_item_props = $ann_item.getProperties())
                                        <tr #announcementsRowClass($ann_item_props $displayOptions $ann_item.Header.draft false)>
                                            #if ($allow_delete)
                                                #set($canDelete = $channel.allowRemoveMessage($ann_item.Message))
                                                #set($ref = $entityManager.newReference($ann_item.Reference))
                                                #set($origChannelRef = $service.channelReference($ref.Context, $ref.Container))
                                                <td class="sakai-table__select sakai-no-print">
                                                    <input class="announcement-select-checkbox" type="checkbox"
                                                        id="check-$rowCount" name="selectedMembers"
                                                        value="$ann_item.Reference"
                                                        #if (!$canDelete || !$origChannelRef.equals($channel.Reference))disabled="disabled"#end
                                                        aria-label="$tlang.getString("gen.selectremove") $formattedText.escapeHtml($ann_item.Header.subject)" />
                                                </td>
                                            #end
                                            <td headers="subject" class="sakai-table__primary" data-label="$tlang.getString('gen.subject')">
                                                #announcementsSubjectMarkers($ann_item)
                                                #if ($ann_item.Header.draft)
                                                    <a href="#toolLinkParam("AnnouncementAction" "doReviseannouncement" "itemReference=$formattedText.escapeUrl($ann_item.reference)")" title="$tlang.getString('gen.editdraft')">$tlang.getFormattedMessage("gen.draft.subject", $formattedText.escapeHtml($ann_item.Header.subject))</a>
                                                #else
                                                    <a href="#toolLinkParam("AnnouncementAction" "doShowmetadata" "itemReference=$formattedText.escapeUrl($ann_item.reference)")" title="$tlang.getFormattedMessage('gen.viewann.subject', $formattedText.escapeHtml($ann_item.Header.subject))">$formattedText.escapeHtml($ann_item.Header.subject)</a>
                                                #end
                                                #if ($ann_item.getRange() || (!$ann_item_props.isEmpty() && ($ann_item_props.getProperty("releaseDate") || $ann_item_props.getProperty("retractDate"))))
                                                <span class="sakai-announcements__meta-line">
                                                    #if ($ann_item.getRange())
                                                        <span>
                                                            <span class="bi bi-people" aria-hidden="true"></span>
                                                            $formattedText.escapeHtml($!ann_item.getRange())
                                                        </span>
                                                    #end
                                                    #if (!$ann_item_props.isEmpty() && $ann_item_props.getProperty("releaseDate"))
                                                        <span>
                                                            <span class="bi bi-clock" aria-hidden="true"></span>
                                                            $tlang.getString("gen.releasedate"): $ann_item_props.getTimeProperty("releaseDate").toStringLocalFull()
                                                        </span>
                                                    #end
                                                    #if (!$ann_item_props.isEmpty() && $ann_item_props.getProperty("retractDate"))
                                                        <span>
                                                            <span class="bi bi-clock-history" aria-hidden="true"></span>
                                                            $tlang.getString("gen.retractdate"): $ann_item_props.getTimeProperty("retractDate").toStringLocalFull()
                                                        </span>
                                                    #end
                                                </span>
                                                #end
                                            </td>
                                            <td headers="author" class="sakai-table__nowrap" data-label="$tlang.getString('gen.from')">
                                                $formattedText.escapeHtml($ann_item.Header.From.DisplayName)
                                            </td>
                                            <td headers="date" class="sakai-table__nowrap" data-label="$tlang.getString('gen.date')">
                                                #if (!$ann_item_props.isEmpty() && $ann_item_props.getProperty("modDate"))
                                                    $ann_item_props.getTimeProperty("modDate").toStringLocalFull()
                                                #else
                                                    $ann_item.Header.Date.toStringLocalFull()
                                                #end
                                            </td>
                                            #if ($EnableItemCheckBoxes)
                                                #if ($SiteColumnFlag > 0)
                                                    <td headers="channel" class="sakai-table__nowrap" data-label="$tlang.getString('gen.site')">
                                                        $formattedText.escapeHtml($ann_item.channelDisplayName)
                                                    </td>
                                                #end
                                            #end
                                            <td class="sakai-table__actions sakai-no-print">
                                                #announcementsRowActions($ann_item)
                                            </td>
                                        </tr>
                                        #if ($displayOptions.isShowAnnouncementBody())
                                            <tr class="sakai-announcements__body-row">
                                                <td colspan="$annColspan">
                                                    <div class="sakai-announcements__body">$ann_item.TrimmedBody</div>
                                                </td>
                                            </tr>
                                        #end
                                    #end
                                </tbody>
                            </table>
                        </div>

                        #if ($allow_delete)
                            <div class="sakai-actions sakai-no-print">
                                <input type="submit" id="announcement-remove-button" class="sakai-btn sakai-btn-secondary" name="eventSubmit_doDeleteannouncement" value="$tlang.getString('gen.delete')" accesskey="s" disabled />
                                <input type="submit" id="announcement-publish-button" class="sakai-btn sakai-btn-secondary" name="eventSubmit_doPublishannouncement" value="$tlang.getString('gen.publish')" accesskey="s" disabled />
                                <input type="submit" id="announcement-unpublish-button" class="sakai-btn sakai-btn-secondary" name="eventSubmit_doUnpublishannouncement" value="$tlang.getString('gen.unpublish')" accesskey="s" disabled />
                                <input type="reset" id="announcement-reset-button" class="sakai-btn sakai-btn-ghost" name="reset" value="$tlang.getString('gen.clearSelections')" accesskey="x" disabled />
                            </div>
                        #end
                        <input type="hidden" name="sakai_csrf_token" value="$sakai_csrf_token" />
                    </form>
                #else
                    #announcementsEmptyState($view)
                    <form name="announcementListForm" action="#toolForm("AnnouncementAction")" method="post">
                        <input type="hidden" name="sakai_csrf_token" value="$sakai_csrf_token" />
                    </form>
                #end

            #else ## compact "list" display option
                #announcementsHeader($tlang.getString("gen.list.title") "doNewannouncement" $menu "")
                #announcementsAlert($alertMessage)

                #if ($messageListVector.iterator().hasNext())
                    <div class="sakai-announcements__pager">
                        <p class="sakai-announcements__pager-label">$tlang.getFormattedMessage("gen.viewing.phrase", $announcementItemRangeArray)</p>
                        <div class="sakai-announcements__pager-controls">
                            #if ($pagesize != 0)
                                <form name="firstpageForm" class="inlineForm" method="post" action="#toolForm("$action")">
                                    <button type="submit" class="sakai-btn sakai-btn-icon" name="eventSubmit_doList_first" value="first" title="$tlang.getString("gen.first")" #if ($goFPButton != "true")disabled="disabled"#end>
                                        <span class="bi bi-chevron-double-left" aria-hidden="true"></span>
                                        <span class="visually-hidden">$tlang.getString("gen.first")</span>
                                    </button>
                                    <input type="hidden" name="sakai_csrf_token" value="$sakai_csrf_token" />
                                </form>
                                <form name="prevpageForm" class="inlineForm" method="post" action="#toolForm("$action")">
                                    <button type="submit" class="sakai-btn sakai-btn-icon" name="eventSubmit_doList_prev" value="prev" title="$tlang.getFormattedMessage('gen.previous.pagesize', $pagesize)" accesskey="p" #if ($goPPButton != "true")disabled="disabled"#end>
                                        <span class="bi bi-chevron-left" aria-hidden="true"></span>
                                        <span class="visually-hidden">$tlang.getFormattedMessage('gen.previous.pagesize', $pagesize)</span>
                                    </button>
                                    <input type="hidden" name="sakai_csrf_token" value="$sakai_csrf_token" />
                                </form>
                            #end
                            <form name="pagesizeForm" class="sakai-announcements__inline-form" method="post" action="#toolForm("$action")">
                                <input type="hidden" name="eventSubmit_doChange_pagesize" value="changepagesize" />
                                <label for="selectPageSize" class="visually-hidden">$tlang.getString("gen.select.label")</label>
                                <select id="selectPageSize" name="selectPageSize" class="sakai-form-control sakai-form-control--sm" onchange="document.pagesizeForm.submit();">
                                    <option value="5" #if($pagesize == 5) selected="selected" #end>$tlang.getFormattedMessage("gen.show", "5")</option>
                                    <option value="10" #if($pagesize == 10) selected="selected" #end>$tlang.getFormattedMessage("gen.show", "10")</option>
                                    <option value="20" #if($pagesize == 20) selected="selected" #end>$tlang.getFormattedMessage("gen.show", "20")</option>
                                    <option value="50" #if($pagesize == 50) selected="selected" #end>$tlang.getFormattedMessage("gen.show", "50")</option>
                                    <option value="100" #if($pagesize == 100) selected="selected" #end>$tlang.getFormattedMessage("gen.show", "100")</option>
                                    <option value="200" #if($pagesize == 200) selected="selected" #end>$tlang.getFormattedMessage("gen.show", "200")</option>
                                </select>
                                <input type="hidden" name="sakai_csrf_token" value="$sakai_csrf_token" />
                            </form>
                            #if ($pagesize != 0)
                                <form name="nextpageForm" class="inlineForm" method="post" action="#toolForm("$action")">
                                    <button type="submit" class="sakai-btn sakai-btn-icon" name="eventSubmit_doList_next" value="next" title="$tlang.getFormattedMessage('gen.next.pagesize', $pagesize)" accesskey="n" #if ($goNPButton != "true")disabled="disabled"#end>
                                        <span class="bi bi-chevron-right" aria-hidden="true"></span>
                                        <span class="visually-hidden">$tlang.getFormattedMessage('gen.next.pagesize', $pagesize)</span>
                                    </button>
                                    <input type="hidden" name="sakai_csrf_token" value="$sakai_csrf_token" />
                                </form>
                                <form name="lastpageForm" class="inlineForm" method="post" action="#toolForm("$action")">
                                    <button type="submit" class="sakai-btn sakai-btn-icon" name="eventSubmit_doList_last" value="last" title="$tlang.getString('gen.last')" #if ($goLPButton != "true")disabled="disabled"#end>
                                        <span class="bi bi-chevron-double-right" aria-hidden="true"></span>
                                        <span class="visually-hidden">$tlang.getString("gen.last")</span>
                                    </button>
                                    <input type="hidden" name="sakai_csrf_token" value="$sakai_csrf_token" />
                                </form>
                            #end
                        </div>
                    </div>

                    <form name="announcementListForm" action="#toolForm("AnnouncementAction")" method="post">
                        <ul class="sakai-announcements__items">
                            #foreach ($ann_item in $showMessagesList)
                                #set($ann_item_props = $ann_item.getProperties())
                                <li class="sakai-announcements__item">
                                    <h4 class="sakai-announcements__item-title">
                                        #announcementsSubjectMarkers($ann_item)
                                        #if ($ann_item.Header.draft)
                                            <a href="#toolLinkParam("AnnouncementAction" "doReviseannouncement" "itemReference=$formattedText.escapeUrl($ann_item.reference)")" title="$tlang.getFormattedMessage("gen.editdraft.subject", $formattedText.escapeHtml($ann_item.Header.subject))">$tlang.getFormattedMessage("gen.draft.subject", $formattedText.escapeHtml($ann_item.Header.subject))</a>
                                        #else
                                            <a href="#toolLinkParam("AnnouncementAction" "doShowmetadata" "itemReference=$formattedText.escapeUrl($ann_item.reference)")" title="$tlang.getFormattedMessage("gen.viewann.subject", $formattedText.escapeHtml($ann_item.Header.subject))">$formattedText.escapeHtml($ann_item.Header.subject)</a>
                                        #end
                                    </h4>
                                    <p class="sakai-announcements__meta">
                                        ($formattedText.escapeHtml($ann_item.Header.From.DisplayName) - $ann_item.Header.Date.toStringLocalFull())
                                    </p>
                                    #if ($displayOptions.isShowAnnouncementBody())
                                        <div class="sakai-announcements__body">$ann_item.TrimmedBody</div>
                                    #end
                                    <div class="sakai-row-actions sakai-announcements__item-actions">
                                        #announcementsRowActions($ann_item)
                                    </div>
                                </li>
                            #end
                        </ul>
                        <input type="hidden" name="sakai_csrf_token" value="$sakai_csrf_token" />
                    </form>
                #else
                    #announcementsEmptyState($view)
                #end
            #end
        #end
    #end
</div>
<script src="/sakai-announcement-tool/js/announcements.js$!{portalCdnQuery}"></script>
