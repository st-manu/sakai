#parse("/vm/announcement/announcements_macros.vm")

<script type="text/javascript">
	focus_path = [ "$form-notify" ];
</script>
<div class="portletBody sakai-tool-body sakai-announcements">
	#announcementsHeader($tlang.getString("custom.options") "" "" "doCancel")
	#announcementsAlert($alertMessage)

	<p class="sakai-announcements__hint">
		#if ($toolId == "sakai.announcements")
			$tlang.getString("custom.setoptions")
		#else
			$tlang.getString("custom.setoptionsrecent")
		#end
	</p>

	<form action="#toolForm("$action")" method="post" name="optionsForm">
	#if ($toolId == "sakai.announcements")
		<fieldset class="sakai-announcements__section">
			<legend class="sakai-announcements__section-title">$tlang.getString("custom.display")</legend>

			#set ($selected = $tlang.getString("custom.sortab"))
			#if ( $displayOptions.isShowAllColumns())
				#if ($displayOptions.isShowAnnouncementBody())
					#set ($selected = $tlang.getString("custom.sortabbod"))
				#else
					#set ($selected = $tlang.getString("custom.sortab"))
				#end
			#else
				#set ($selected = $tlang.getString("custom.lisvie"))
			#end

			<div class="sakai-announcements__choice">
				<input type="radio" id="sortable" name="VarNameDisplaySelection" value="sortable"
					#if ($selected == $tlang.getString("custom.sortab"))checked="checked"#end />
				<label for="sortable">$tlang.getString("custom.sortab")</label>
			</div>

			<div class="sakai-announcements__choice">
				<input type="radio" id="sortableWithBody" name="VarNameDisplaySelection" value="sortableWithBody"
					#if ($selected == $tlang.getString("custom.sortabbod"))checked="checked"#end />
				<label for="sortableWithBody">$tlang.getString("custom.sortabbod")</label>
			</div>

			<div class="sakai-announcements__choice">
				<input type="radio" id="showList" name="VarNameDisplaySelection" value="list"
					#if ($selected == $tlang.getString("custom.lisvie"))checked="checked"#end />
				<label for="showList">$tlang.getString("custom.lisvie")</label>
			</div>

			<div class="sakai-form-group" id="charDisplay">
				<label for="changeChars" class="sakai-form-label">$tlang.getString("custom.charbody")</label>
				#if ($displayOptions.isEnforceNumberOfCharsPerAnnouncement())
					#if ($displayOptions.NumberOfCharsPerAnnouncement == 50)
						#set ($selectedChars = $tlang.getString("custom.shofir"))
					#else
						#if ($displayOptions.NumberOfCharsPerAnnouncement == 100)
							#set ($selectedChars = $tlang.getString("custom.shofirtwo"))
						#else
							#set ($selectedChars = $tlang.getString("custom.shoall"))
						#end
					#end
				#else
					#set ($selectedChars = $tlang.getString("custom.shoall"))
				#end

				<select id="changeChars" name="changeChars" size="1" class="sakai-form-control">
				#foreach ($chars in ["$tlang.getString('custom.shofir')", "$tlang.getString('custom.shofirtwo')", "$tlang.getString('custom.shoall')"])
					#if ($selectedChars.equals($chars))
						<option value="$chars" selected="selected" >$chars</option>
					#else
						<option value="$chars" >$chars</option>
					#end
				#end
				</select>
			</div>
		</fieldset>

		<fieldset class="sakai-announcements__section">
			<legend class="sakai-announcements__section-title">$tlang.getString("custom.rss_option.full")</legend>

			<div class="sakai-form-group">
				<label for="rssAlias" class="sakai-form-label">$tlang.getString("custom.rss_alias")</label>
				<input type="text" name="rssAlias" id="rssAlias" maxlength="40" value="$!rssAlias" class="sakai-form-control" />
			</div>

			<div class="sakai-form-group">
				<span class="sakai-form-label">$tlang.getString("custom.rss_url")</span>
				<a target="_blank" href="$!rssUrl" class="url">$rssUrl</a>
			</div>
		</fieldset>

	#else
		<fieldset class="sakai-announcements__section">
			<legend class="sakai-announcements__section-title">$tlang.getString("custom.display")</legend>

			<div class="sakai-announcements__choice">
				<input type="checkbox"
					name="$displayOptions.getVarNameShowAnnouncementBody()"
					id="${displayOptions.getVarNameShowAnnouncementBody()}Check"
					value="true"
					#if ($displayOptions.isShowAnnouncementBody())checked="checked"#end />
				<label for="${displayOptions.getVarNameShowAnnouncementBody()}Check">$tlang.getString("custom.showbody")</label>
			</div>

			<div class="sakai-form-group" id="charDisplay">
				<label for="changeChars" class="sakai-form-label">$tlang.getString("custom.about")</label>
				#if ($displayOptions.isEnforceNumberOfCharsPerAnnouncement())
					#if ($displayOptions.NumberOfCharsPerAnnouncement == 50)
						#set ($selectedChars = $tlang.getString("custom.shofir"))
					#else
						#if ($displayOptions.NumberOfCharsPerAnnouncement == 100)
							#set ($selectedChars = $tlang.getString("custom.shofirtwo"))
						#else
							#set ($selectedChars = $tlang.getString("custom.shoall"))
						#end
					#end
				#else
					#set ($selectedChars = $tlang.getString("custom.shoall"))
				#end

				<select id="changeChars" name="changeChars" size="1" class="sakai-form-control">
				#foreach ($chars in ["$tlang.getString('custom.shofir')", "$tlang.getString('custom.shofirtwo')", "$tlang.getString('custom.shoall')"])
					#if ($selectedChars.equals($chars))
						<option value="$chars" selected="selected" >$chars</option>
					#else
						<option value="$chars" >$chars</option>
					#end
				#end
				</select>
			</div>
		</fieldset>
	#end

		<fieldset class="sakai-announcements__section">
			<legend class="sakai-announcements__section-title">$tlang.getString("custom.dplimits")</legend>

			<div class="sakai-form-group">
				<label for="${displayOptions.getVarNameNumberOfDaysInPast()}EntryField" class="sakai-form-label">$tlang.getString("custom.number")</label>
				<input type="text" id="${displayOptions.getVarNameNumberOfDaysInPast()}EntryField" name="$displayOptions.getVarNameNumberOfDaysInPast()" size="2"
					class="sakai-form-control sakai-announcements__number-input"
					#if ($displayOptions.isEnforceNumberOfDaysInThePastLimit())
						value="$displayOptions.NumberOfDaysInThePast"
					#else
						value=""
					#end />
			</div>

			<div class="sakai-form-group">
				<label for="${displayOptions.getVarNameNumberOfAnnouncements()}EntryField" class="sakai-form-label">$tlang.getString("custom.numbann")</label>
				<input type="text" id="${displayOptions.getVarNameNumberOfAnnouncements()}EntryField" size="2"
					class="sakai-form-control sakai-announcements__number-input"
					name="$displayOptions.getVarNameNumberOfAnnouncements()"
					#if ($displayOptions.isEnforceNumberOfAnnouncementsLimit())
						value="$displayOptions.NumberOfAnnouncements"
					#else
						value=""
					#end />
			</div>
		</fieldset>

		<div class="sakai-actions">
			<input type="submit" class="sakai-btn sakai-btn-primary" name="eventSubmit_doUpdate" value="$tlang.getString("gen.update")" accesskey="s" />
			<input type="submit" class="sakai-btn sakai-btn-ghost" name="eventSubmit_doCancel" value="$tlang.getString("gen.cancel")" accesskey="x" />
		</div>
		<input type="hidden" name="sakai_csrf_token" value="$sakai_csrf_token" />
	</form>
</div>
