#parse("/vm/announcement/announcements_macros.vm")

<script type="text/JavaScript">
  function change_parent_url(url)
  {
    parent.location=url;
  }
</script>

<div class="portletBody sakai-tool-body sakai-announcements">
    #announcementsHeader($formattedText.escapeHtml($message.Header.subject) $menu true)
    #announcementsAlert($alertMessage)

    <dl class="sakai-announcements__details">
        #if ($message.Header.From.DisplayName)
            <div class="sakai-announcements__detail">
                <dt>$tlang.getString("gen.from")</dt>
                <dd>$formattedText.escapeHtml($message.Header.From.DisplayName)</dd>
            </div>
        #end
        #if ($modDate || $message.Header.Date)
            <div class="sakai-announcements__detail">
                <dt>$tlang.getString("gen.mod")</dt>
                <dd>
                    #if ($modDate)
                        $modDate.toStringLocalFull()
                    #elseif ($message.Header.Date)
                        $message.Header.Date.toStringLocalFull()
                    #end
                </dd>
            </div>
        #end
        #if ($releaseDate)
            <div class="sakai-announcements__detail">
                <dt>$tlang.getString("gen.releasedate")</dt>
                <dd>$releaseDate.toStringLocalFull()</dd>
            </div>
        #end
        #if ($retractDate)
            <div class="sakai-announcements__detail">
                <dt>$tlang.getString("gen.retractdate")</dt>
                <dd>$retractDate.toStringLocalFull()</dd>
            </div>
        #end
        #if ($!range)
            <div class="sakai-announcements__detail">
                <dt>$tlang.getString("meta.groups")</dt>
                <dd>$formattedText.escapeHtml($!range)</dd>
            </div>
        #end
        #if ($assignmenturl && $assignmenturl != "")
            <div class="sakai-announcements__detail">
                <dt>$tlang.getString("gen.assignmentlink")</dt>
                <dd><a href="javascript:change_parent_url('$assignmenturl');">$formattedText.escapeHtml($validator.limit($!assignmenttitle, 40))</a></dd>
            </div>
        #end
    </dl>

    <section class="sakai-announcements__section">
        <h2 class="sakai-announcements__section-title">$tlang.getString("meta.message")</h2>
        <div class="sakai-announcements__body">$formattedText.escapeHtmlFormattedText($message.body)</div>
    </section>

    #set ($size = 0)
    #if (!$message.Header.Attachments.isEmpty())
        <section class="sakai-announcements__section">
            <h2 class="sakai-announcements__section-title">$tlang.getString("meta.attach")</h2>
            <ul class="sakai-announcements__attachments">
                #set ($props = false)
                #set ($size = $message.Header.Attachments.size())
                #foreach ($attachment in $message.Header.Attachments)
                    #set ($props = $attachment.Properties)
                    #if (!$props)
                        #if ($size > 0) #set ($size = $size - 1) #end
                    #else
                        <li>
                            #if ($props.getBooleanProperty($props.NamePropIsCollection))
                                <img src="#imageLink($contentTypeImageService.getContentTypeImage("folder"))" alt="" />
                            #else
                                <img src="#imageLink($contentTypeImageService.getContentTypeImage($props.getProperty($props.NamePropContentType)))" alt="" />
                            #end
                            <a href="$attachment.Url" target="_blank" title="$tlang.getString("gen.newwindow")">$formattedText.escapeHtml($attachment.Properties.getPropertyFormatted("DAV:displayname"))</a>
                            #if (!$props.getBooleanProperty($props.NamePropIsCollection) && $props.getProperty("DAV:getcontenttype") != "text/url")
                                <span class="sakai-announcements__attachment-size">($props.getPropertyFormatted($props.NamePropContentLength))</span>
                            #end
                        </li>
                    #end
                #end
            </ul>
        </section>
    #end

    #if ($toolId == "sakai.announcements")
        <form name="formII" action="#toolForm("$action")" method="post">
            <div class="sakai-actions">
                <button type="submit" class="sakai-btn sakai-btn-secondary" name="eventSubmit_doPrev_message" #if (!$goPTButton)disabled="disabled"#end>
                    <span class="bi bi-chevron-left" aria-hidden="true"></span>
                    <span>$tlang.getString("meta.prev")</span>
                </button>
                <button type="submit" class="sakai-btn sakai-btn-ghost" name="eventSubmit_doLinkcancel">$tlang.getString("meta.retlis")</button>
                <button type="submit" class="sakai-btn sakai-btn-secondary" name="eventSubmit_doNext_message" #if (!$goNTButton)disabled="disabled"#end>
                    <span>$tlang.getString("meta.next")</span>
                    <span class="bi bi-chevron-right" aria-hidden="true"></span>
                </button>
            </div>
            <input type="hidden" name="sakai_csrf_token" value="$sakai_csrf_token" />
        </form>
    #else
        <form name="formII" action="#toolForm("$action")" method="post">
            <div class="sakai-actions">
                <button type="submit" class="sakai-btn sakai-btn-primary" name="eventSubmit_doLinkcancel" accesskey="x">$tlang.getString("meta.retlis")</button>
            </div>
            <input type="hidden" name="sakai_csrf_token" value="$sakai_csrf_token" />
        </form>
    #end
</div>
