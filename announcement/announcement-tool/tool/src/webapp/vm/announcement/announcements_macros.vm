#*
 * Announcements fragments. Actions come from $menu so permissions and
 * enablement stay in MenuBuilder; see niobe-front-rules/announcements-reference.md.
 *#

#macro(announcementsHeader $title $primaryAction $menu $backAction)
#sakaiToolHeader($title $menu $primaryAction $backAction $tlang.getString("meta.retlis") $tlang.getString("gen.more.actions"))
#end

#macro(announcementsAlert $alertMessage)
    #if ($alertMessage)
<div class="sakai-banner sakai-banner--error" role="alert">
    $tlang.getFormattedMessage("gen.alert.message", $alertMessage)
</div>
    #end
#end

#macro(announcementsEmptyState $view)
<div class="sakai-banner sakai-banner--info" role="status">
    #if ($view == "view.public")
        $tlang.getString("gen.therearepublic")
    #elseif ($view == "view.bygroup")
        $tlang.getString("gen.therearegroup")
    #elseif ($view == "view.byrole")
        $tlang.getString("gen.therearerole")
    #else
        $tlang.getString("gen.thereare")
    #end
</div>
#end

#macro(announcementsSortTh $thId $sortKey $sortAction $label $sortTitle $sortAscTitle $sortDescTitle $extraClass)
    #set($ariaSort = "none")
    #set($sortStateClass = "")
    #set($currentTitle = $sortTitle)
    #if ($currentSortedBy == $sortKey)
        #if ($currentSortAsc == "true")
            #set($ariaSort = "ascending")
            #set($sortStateClass = "is-sorted-asc")
            #set($currentTitle = $sortAscTitle)
        #else
            #set($ariaSort = "descending")
            #set($sortStateClass = "is-sorted-desc")
            #set($currentTitle = $sortDescTitle)
        #end
    #end
    <th id="$thId" scope="col" aria-sort="$ariaSort"#if($extraClass != "") class="$extraClass"#end>
        <a href="#" class="sakai-table__sort $sortStateClass" title="$currentTitle"
            onclick="location='#toolLink("AnnouncementAction" $sortAction)';return false;">
            <span>$label</span>
        </a>
    </th>
#end

#macro(announcementsRowActions $ann_item)
    #set($canRevise = $channel.allowEditMessage($ann_item.Id))
    #set($ref = $entityManager.newReference($ann_item.Reference))
    #set($origChannelRef = $service.channelReference($ref.Context, $ref.Container))
    #set($canDelete = $channel.allowRemoveMessage($ann_item.Message) && $origChannelRef.equals($channel.Reference))
    #if ($canRevise || $canDelete)
    <div class="sakai-row-actions">
        <details class="sakai-overflow-menu">
            <summary class="sakai-overflow-menu__toggle"
                aria-label="$tlang.getString('gen.more.actions') $formattedText.escapeHtml($ann_item.Header.subject)">
                <span class="bi bi-three-dots" aria-hidden="true"></span>
            </summary>
            <div class="sakai-overflow-menu__panel" role="menu">
                #if ($canRevise)
                <a role="menuitem"
                    href="#toolLinkParam("AnnouncementAction" "doReviseannouncement" "itemReference=$formattedText.escapeUrl($ann_item.reference)")"
                    title="$tlang.getFormattedMessage('gen.editann.subject', $formattedText.escapeHtml($ann_item.Header.subject))">
                    <span class="bi bi-pencil" aria-hidden="true"></span>
                    <span>$tlang.getString("gen.revise")<span class="visually-hidden"> $formattedText.escapeHtml($ann_item.Header.subject)</span></span>
                </a>
                #end
                #if ($canDelete)
                <a role="menuitem"
                    href="#toolLinkParam("AnnouncementAction" "doDelete_announcement_link" "itemReference=$formattedText.escapeUrl($ann_item.reference)")"
                    title="$tlang.getFormattedMessage('gen.removeann.subject', $formattedText.escapeHtml($ann_item.Header.subject))">
                    <span class="bi bi-trash" aria-hidden="true"></span>
                    <span>$tlang.getString("gen.delete")<span class="visually-hidden"> $formattedText.escapeHtml($ann_item.Header.subject)</span></span>
                </a>
                #end
            </div>
        </details>
    </div>
    #end
#end

#macro(announcementsSubjectMarkers $ann_item)
    #set($isHighlighted = $ann_item.getProperties().getProperty("highlight"))
    #if ("$!isHighlighted" == "true")
        <span class="bi bi-star-fill sakai-announcements__star" aria-hidden="true" title="$tlang.getString('revise.star.title')"></span>
        <span class="visually-hidden">$tlang.getString('revise.star.title')</span>
    #end
    #set($attachmentCount = 0)
    #if (!$ann_item.Header.Attachments.isEmpty())
        #foreach ($attachment in $ann_item.Header.Attachments)
            #if ($attachment.Properties)
                #set($attachmentCount = $attachmentCount + 1)
            #end
        #end
    #end
    #if ($attachmentCount > 0)
        <span class="bi bi-paperclip sakai-announcements__attachment" aria-hidden="true"></span>
        <span class="visually-hidden">$tlang.getString('gen.includeattachments')</span>
    #end
#end
